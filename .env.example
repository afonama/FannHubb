# ---------------------------------------------------------------------------
# Fan Hub Plus - example environment
#
#   cp .env.example .env
#
# Every value below is a PLACEHOLDER. Nothing here is a real credential, and
# this file is the only env file that is allowed to be committed (.gitignore
# whitelists exactly this name). Replace every CHANGE_ME before you run
# `alembic upgrade head` or `python scripts/seed.py`.
#
# This file mirrors app/core/config.py; if you add a setting there, add it here.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- app
APP_NAME="Fan Hub Plus"
APP_VERSION=1.0.0
# local | dev | staging | prod
APP_ENV=local
# Never true in staging/prod: it echoes password-reset links in API responses.
DEBUG=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
# TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------------ database
# Required. Use the POOLED Neon connection string (hostname contains "-pooler").
# Note the asyncpg driver - config.py rewrites postgres:// for you but be explicit.
#   postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@ep-CHANGE_ME-pooler.REGION.neon.tech/CHANGE_ME_DBNAME?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Recycle below the provider's idle cutoff so pooled connections stay healthy.
DB_POOL_RECYCLE=900
DB_ECHO=false
# Schema search_path override. Leave empty in normal use; the test suite points
# this at a throwaway schema so it never touches real data.
DB_SEARCH_PATH=

# --------------------------------------------------------------- redis
# Empty => in-process fallback cache (fine for a single worker, not for prod).
# Upstash/Neon KV style TLS URL: rediss://default:PASSWORD@HOST:PORT
REDIS_URL=
REDIS_ENABLED=true
REDIS_SOCKET_TIMEOUT=1.0
REDIS_CONNECT_TIMEOUT=1.0

# ----------------------------------------------------------------- jwt
# Required. Must be >= 32 characters in prod or startup aborts.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_48
JWT_ALGORITHM=HS256
JWT_ISSUER=fan-hub-plus
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# How a reset link reaches the user:
#   log  - written to the application log (development only)
#   none - nothing is generated and the API says so
# No mail transport is wired up yet; see README "Password reset".
PASSWORD_RESET_DELIVERY=log

# --------------------------------------------------------------- cors
# Comma-separated allow-list. Required in prod, and "*" is rejected there.
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------- chatbot
CHATBOT_ENABLED=true
# rules (offline FAQ matcher) | llm (OpenAI-compatible, needs a key below)
CHATBOT_PROVIDER=rules
CHATBOT_LLM_API_KEY=
CHATBOT_LLM_BASE_URL=https://api.openai.com/v1
CHATBOT_LLM_MODEL=gpt-4o-mini
CHATBOT_MAX_MESSAGE_LENGTH=2000
CHATBOT_SESSION_TTL_HOURS=24

# -------------------------------------------------------- rate limits
# Fixed window per client IP. Auth routes bucket on IP|email.
# NOTE: client_ip() trusts X-Forwarded-For, so only expose the API through a
# proxy that overwrites that header.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REGISTER_WINDOW=900
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_FORGOT_PASSWORD=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=900
RATE_LIMIT_FEEDBACK=5
RATE_LIMIT_FEEDBACK_WINDOW=3600
RATE_LIMIT_CHATBOT=20
RATE_LIMIT_CHATBOT_WINDOW=300

# --------------------------------------------------------------- media
MEDIA_ROOT=media
MEDIA_MAX_UPLOAD_BYTES=5242880
# Absolute origin of this deployment. Password-reset links are built from it.
PUBLIC_BASE_URL=http://localhost:8000

# ----------------------------------------------------------- scheduler
# APScheduler flushes Redis view/popularity deltas into Postgres.
SCHEDULER_ENABLED=true
POPULARITY_FLUSH_INTERVAL_SECONDS=60

# ---------------------------------------------------------------- seed
# Consumed by scripts/seed.py only. These are demo credentials: change them
# before seeding anything you intend to expose, and never reuse them in prod.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
# Comma-separated. settings.seed_user_email_list parses this.
SEED_USER_EMAILS=user1@example.com,user2@example.com,user3@example.com
SEED_USER_PASSWORD=CHANGE_ME_user_password
